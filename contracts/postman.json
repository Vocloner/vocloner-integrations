        "url": "{{base_url}}/audio-tools/trim",
        "description": "Check /capabilities for available operations and options. Supply exactly one owned file or generation. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_processAudio in collection variables ONLY to start a new operation.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"file_id\": \"ab198ae5-9225-40f3-b176-56ed83861080\",\n  \"options\": {\n    \"start_ms\": 0,\n    \"end_ms\": 5000\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
