        "url": "{{base_url}}/consent-challenges",
        "description": "Obtain a temporary phrase, record it and upload the audio with purpose: consent. Include both identifiers when cloning. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_createConsent in collection variables ONLY to start a new operation.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"locale\": \"es\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
