      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_completeFile}}"
          }
        ],
        "url": "{{base_url}}/files/{{resource_id}}/complete",
        "description": "Validate actual content, size, duration and hash before allowing use. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_completeFile in collection variables ONLY to start a new operation."
      }
    },
    {
      "name": "Get a file",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/files/{{resource_id}}",
        "description": "Retrieve status, duration and expiration of an owned file. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_getFile in collection variables ONLY to start a new operation."
      }
    },
    {
      "name": "Delete a file",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/files/{{resource_id}}",
        "description": "Delete an owned file when no active job needs it. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_deleteFile in collection variables ONLY to start a new operation."
      }
    },
