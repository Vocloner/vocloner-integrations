    {
      "name": "List jobs",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/jobs",
        "description": "Paginated owned jobs ordered by creation. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_listJobs in collection variables ONLY to start a new operation."
      }
    },
    {
      "name": "Get a job",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/jobs/{{resource_id}}",
        "description": "Retrieve status, result and billed characters. Respect Retry-After before polling again. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_getJob in collection variables ONLY to start a new operation."
      }
    },
    {
      "name": "Cancel a job",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const variable = 'idempotency_cancelJob';",
              "if (!pm.collectionVariables.get(variable)) pm.collectionVariables.set(variable, pm.variables.replaceIn('{{$guid}}'));"
