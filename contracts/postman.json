      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_createDialogue}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/dialogues",
        "description": "Between two and ten lines. Every voice must be authorized and the plan must enable dialogues. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_createDialogue in collection variables ONLY to start a new operation.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"lines\": [\n    {\n      \"voice_id\": \"c816ce5b-22f5-4ed2-91a9-90e79b874a24\",\n      \"text\": \"Hola.\"\n    },\n    {\n      \"voice_id\": \"c816ce5b-22f5-4ed2-91a9-90e79b874a24\",\n      \"text\": \"Bienvenido.\"\n    }\n  ],\n  \"gap_ms\": 400\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Prepare an upload",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const variable = 'idempotency_createFile';",
              "if (!pm.collectionVariables.get(variable)) pm.collectionVariables.set(variable, pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_createFile}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/files",
        "description": "Obtain a temporary authorization for a direct upload to private Storage. Confirm the upload using /complete afterwards. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_createFile in collection variables ONLY to start a new operation.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"file_name\": \"voz.wav\",\n  \"content_type\": \"audio/wav\",\n  \"size_bytes\": 1048576,\n  \"purpose\": \"clone\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Complete an upload",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const variable = 'idempotency_completeFile';",
              "if (!pm.collectionVariables.get(variable)) pm.collectionVariables.set(variable, pm.variables.replaceIn('{{$guid}}'));"
