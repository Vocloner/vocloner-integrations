  "item": [
    {
      "name": "List voices",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/voices",
        "description": "Owned voices and authorized public voices. Paginate with cursor and limit. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_listVoices in collection variables ONLY to start a new operation."
      }
    },
    {
      "name": "Get a voice",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/voices/{{resource_id}}",
        "description": "Retrieve metadata for a voice you are allowed to use. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_getVoice in collection variables ONLY to start a new operation."
      }
    },
    {
      "name": "Clone a voice",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const variable = 'idempotency_cloneVoice';",
              "if (!pm.collectionVariables.get(variable)) pm.collectionVariables.set(variable, pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_cloneVoice}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/voices",
        "description": "Upload and confirm a recording before cloning. Include a recorded challenge when required. New voices are private. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_cloneVoice in collection variables ONLY to start a new operation.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"file_id\": \"ab198ae5-9225-40f3-b176-56ed83861080\",\n  \"name\": \"Mi voz\",\n  \"consent_ownership\": true,\n  \"language\": \"es\",\n  \"category\": \"narrator\",\n  \"locale\": \"es\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Update a voice",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const variable = 'idempotency_updateVoice';",
              "if (!pm.collectionVariables.get(variable)) pm.collectionVariables.set(variable, pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_updateVoice}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/voices/{{resource_id}}",
        "description": "Update the name, language or category of an owned voice. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_updateVoice in collection variables ONLY to start a new operation.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Narración\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Delete a voice",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{base_url}}/voices/{{resource_id}}",
        "description": "Delete an owned voice. Existing generations keep their retention rules. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_deleteVoice in collection variables ONLY to start a new operation."
      }
    },
    {
      "name": "Request publication",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const variable = 'idempotency_requestPublication';",
              "if (!pm.collectionVariables.get(variable)) pm.collectionVariables.set(variable, pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_requestPublication}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/voices/{{resource_id}}/publication-requests",
        "description": "Confirm public use permission and request review. A request does not automatically publish the voice. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_requestPublication in collection variables ONLY to start a new operation.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"consent_public_use\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Report a voice",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const variable = 'idempotency_reportVoice';",
              "if (!pm.collectionVariables.get(variable)) pm.collectionVariables.set(variable, pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_reportVoice}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/voices/{{resource_id}}/reports",
        "description": "Report impersonation, missing consent or other abuse for review. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_reportVoice in collection variables ONLY to start a new operation.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"reason\": \"no_consent\",\n  \"detail\": \"Información para la revisión.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Design voice candidates",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const variable = 'idempotency_createDesign';",
              "if (!pm.collectionVariables.get(variable)) pm.collectionVariables.set(variable, pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_createDesign}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/voice-designs",
        "description": "Describe a voice to obtain temporary candidates. Save a candidate before using it for speech. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_createDesign in collection variables ONLY to start a new operation.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"prompt\": \"Una voz cálida, clara y pausada para narración en español.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Get a voice design",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/voice-designs/{{resource_id}}",
        "description": "Retrieve candidates and expiration for an owned design batch. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_getDesign in collection variables ONLY to start a new operation."
      }
    },
    {
      "name": "Save a candidate",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const variable = 'idempotency_selectDesign';",
              "if (!pm.collectionVariables.get(variable)) pm.collectionVariables.set(variable, pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_selectDesign}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/voice-designs/{{resource_id}}/voices",
        "description": "Create a reusable private voice without charging the design again. Requires an available voice slot. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_selectDesign in collection variables ONLY to start a new operation.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"candidate_id\": \"c816ce5b-22f5-4ed2-91a9-90e79b874a24\",\n  \"name\": \"Narradora\",\n  \"language\": \"es\",\n  \"category\": \"narrator\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Generate speech",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const variable = 'idempotency_createSpeech';",
              "if (!pm.collectionVariables.get(variable)) pm.collectionVariables.set(variable, pm.variables.replaceIn('{{$guid}}'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Idempotency-Key",
            "value": "{{idempotency_createSpeech}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{base_url}}/speech",
        "description": "Convert text to MP3 or WAV. Supports compatible expressive tags. Prefer: wait=20 waits up to twenty seconds; the response may still be 202. Reuse the same Idempotency-Key when retrying a write. Clear idempotency_createSpeech in collection variables ONLY to start a new operation.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"voice_id\": \"c816ce5b-22f5-4ed2-91a9-90e79b874a24\",\n  \"text\": \"Hola, esta es mi primera generación con Vocloner.\",\n  \"format\": \"mp3\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Generate a dialogue",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const variable = 'idempotency_createDialogue';",
              "if (!pm.collectionVariables.get(variable)) pm.collectionVariables.set(variable, pm.variables.replaceIn('{{$guid}}'));"
            ]
